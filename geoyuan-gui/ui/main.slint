                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 16px;
                    height: 180px;

                    VerticalLayout {
                        padding: 32px;
                        spacing: 16px;
                        alignment: center;

                        Text {
                            text: "GY 余额";
                            font-size: 16px;
                            color: Theme.text-secondary;
                        }

                        Text {
                            text: root.gy_balance + " GY";
                            font-size: 56px;
                            font-weight: 900;
                            color: Theme.neon-green;
                        }

                        Text {
                            text: "≈ ¥" + (root.gy_balance.to-float() * 10) + " CNY";
                            font-size: 14px;
                            color: Theme.text-secondary;
                        }
                    }
                }

                // 钱包地址
                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 16px;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        Text {
                            text: "🔗 钱包地址";
                            font-size: 14px;
                            color: Theme.text-secondary;
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            Rectangle {
                                background: Theme.input-bg;
                                border-radius: 8px;
                                height: 44px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    padding: 12px;

                            Text {
                                text: root.wallet_address;
                                font-size: 14px;
                                font-family: "monospace";
                                color: Theme.text-primary;
                            }
                                }
                            }

                            CyberButtonOutline {
                                label: "复制";
                                clicked => { root.copy_gyid(root.wallet_address); }
                            }
                        }
                    }
                }

                // 最近交易
                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 16px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        Text {
                            text: "📜 最近交易";
                            font-size: 16px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }

                        VerticalLayout {
                            spacing: 8px;

                            if root.wallet_tx1_title != "" : TransactionItem {
                                tx_icon: root.wallet_tx1_icon;
                                tx_title: root.wallet_tx1_title;
                                tx_amount: root.wallet_tx1_amount;
                                tx_time: root.wallet_tx1_time;
                                tx_status: root.wallet_tx1_status;
                            }

                            if root.wallet_tx2_title != "" : TransactionItem {
                                tx_icon: root.wallet_tx2_icon;
                                tx_title: root.wallet_tx2_title;
                                tx_amount: root.wallet_tx2_amount;
                                tx_time: root.wallet_tx2_time;
                                tx_status: root.wallet_tx2_status;
                            }

                            if root.wallet_tx1_title == "" : Text {
                                text: "暂无交易记录";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
