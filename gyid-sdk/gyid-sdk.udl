// GyID SDK - UniFFI 绑定定义
// 用于自动生成 Swift/Kotlin/Python 绑定

namespace gyid {
    // 地理精度等级
    enum GeoLevel {
        "city";
        "district";
        "exact";
    }

    // 生成选项
    dictionary GenerateOptions {
        string? geo_level = "city";
        boolean with_geo = true;
        string? avatar_path = null;
    }

    // GyID 生成结果
    dictionary GyIdResult {
        string id;
        string hash;
        i64 created_at_ms;
        i32 linked_devices;
        string platform;
        string sdk_version;
    }

    // 设备信息
    dictionary DeviceInfo {
        string linked_gyid;
        string link_id;
        i64 linked_at_ms;
        boolean active;
    }

    // 设备列表
    dictionary DeviceList {
        string master_gyid;
        sequence<DeviceInfo> devices;
    }

    // SDK 版本信息
    dictionary SdkVersion {
        string version;
        string platform;
        sequence<string> features;
    }

    // SDK API
    interface GyIdSdk {
        // 生成 GyID
        [Throws=Error]
        GyIdResult generate_default();
        [Throws=Error]
        GyIdResult generate(GenerateOptions options);

        // 验证 GyID
        boolean verify(string gyid);

        // 设备关联
        [Throws=Error]
        DeviceList get_devices(string? master_gyid = null);
        [Throws=Error]
        string export_json();

        // 版本信息
        SdkVersion version();
    }
}
