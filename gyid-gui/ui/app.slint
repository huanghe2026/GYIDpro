// GyID GUI - Slint 1.8 UI (完整版)

import { Button, ListView, VerticalBox } from "std-widgets.slint";

export struct HistoryItem {
    id: string,
    time: string,
    geo_level: string,
}

// ============================================================
// Main Window
// ============================================================
export component AppWindow inherits Window {
    title: "GyID v0.4.1 - 去中心化身份生成器";
    width: 900px;
    height: 700px;
    background: #0a0a0f;
    
    // 回调
    callback generate();
    callback cancel();
    callback export-qr(string);
    callback export-json(string);
    callback change-geo-level(int);
    callback toggle-avatar(bool);

    // 属性
    in-out property<string> status_text: "就绪";
    in-out property<bool> is_generating: false;
    in-out property<string> gyid_result: "";
    in-out property<string> avatar_base64: "";
    in-out property<bool> has_result: false;
    in-out property<int> geo_level: 0;
    in-out property<bool> use_avatar: false;
    in-out property<[HistoryItem]> history: [];

    // 状态颜色
    property<color> status_color: #4ade80;
    
    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // ── 标题栏 ──────────────────────────────────
        Rectangle {
            background: #12121a;
            border-radius: 12px;
            
            HorizontalLayout {
                padding: 20px;
                
                VerticalLayout {
                    spacing: 4px;
                    
                    Text {
                        text: "GyID Generator";
                        font-size: 32px;
                        font-weight: 700;
                        color: #ffd700;
                    }
                    
                    Text {
                        text: "去中心化身份生成器 v0.4.1";
                        font-size: 14px;
                        color: #6b7280;
                    }
                }
                
                Rectangle { horizontal-stretch: 1; }
                
                // 状态指示器
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: root.is_generating ? #f59e0b : root.status_color;
                    }
                    
                    Text {
                        text: root.status_text;
                        font-size: 12px;
                        color: #9ca3af;
                    }
                }
            }
        }

        // ── 主内容区 ─────────────────────────────────
        HorizontalLayout {
            spacing: 16px;
            
            // 左侧：生成控制
            VerticalLayout {
                spacing: 16px;
                min-width: 350px;
                
                // GyID 结果显示
                Rectangle {
                    background: #12121a;
                    border-radius: 12px;
                    padding: 20px;
                    
                    VerticalLayout {
                        spacing: 12px;
                        
                        Text {
                            text: "Generated GyID";
                            font-size: 14px;
                            color: #9ca3af;
                        }
                        
                        if root.has_result: Rectangle {
                            background: #1a1a24;
                            border-radius: 8px;
                            padding: 16px;
                            
                            VerticalLayout {
                                spacing: 8px;
                                
                                Text {
                                    text: root.gyid_result;
                                    font-size: 16px;
                                    font-weight: 500;
                                    color: #e5e7eb;
                                    wrap: word-wrap;
                                }
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    
                                    Button {
                                        text: "复制 GyID";
                                        clicked => { root.export-qr(root.gyid_result); }
                                    }
                                    
                                    Button {
                                        text: "导出JSON";
                                        clicked => { root.export-json(root.gyid_result); }
                                    }
                                }
                            }
                        }
                        
                        if !root.has_result: Text {
                            text: "点击下方按钮生成您的 GyID";
                            font-size: 14px;
                            color: #4b5563;
                        }
                    }
                }
                
                // 生成控制
                Rectangle {
                    background: #12121a;
                    border-radius: 12px;
                    padding: 20px;
                    
                    VerticalLayout {
                        spacing: 16px;
                        
                        Text {
                            text: "生成设置";
                            font-size: 14px;
                            font-weight: 600;
                            color: #e5e7eb;
                        }
                        
                        // 地理精度选择
                        VerticalLayout {
                            spacing: 8px;
                            
                            Text {
                                text: "地理精度";
                                font-size: 12px;
                                color: #9ca3af;
                            }
                            
                            HorizontalLayout {
                                spacing: 8px;
                                
                                for level[idx] in [
                                    { label: "城市", value: 0 },
                                    { label: "区域", value: 1 },
                                    { label: "精确", value: 2 }
                                ]: Rectangle {
                                    background: root.geo_level == level.value ? #ffd700 : #1a1a24;
                                    border-radius: 6px;
                                    padding: 8px;
                                    
                                    TouchArea {
                                        clicked => { root.change-geo-level(level.value); }
                                    }
                                    
                                    Text {
                                        text: level.label;
                                        font-size: 12px;
                                        color: root.geo_level == level.value ? #0a0a0f : #e5e7eb;
                                    }
                                }
                            }
                        }
                        
                        // 头像选项
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            
                            Text {
                                text: "使用头像";
                                font-size: 12px;
                                color: #9ca3af;
                            }
                            
                            Rectangle {
                                width: 40px;
                                height: 20px;
                                border-radius: 10px;
                                background: root.use_avatar ? #ffd700 : #374151;
                                
                                TouchArea {
                                    clicked => { root.toggle-avatar(!root.use_avatar); }
                                }
                                
                                Rectangle {
                                    x: root.use_avatar ? 22px : 2px;
                                    y: 2px;
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 8px;
                                    background: white;
                                    animate x { duration: 150ms; }
                                }
                            }
                        }
                        
                        // 按钮
                        if !root.is_generating: Button {
                            text: "生成 GyID";
                            primary: true;
                            height: 44px;
                            clicked => { root.generate(); }
                        }
                        
                        if root.is_generating: Button {
                            text: "取消";
                            height: 44px;
                            clicked => { root.cancel(); }
                        }
                    }
                }
            }
            
            // 右侧：历史记录
            Rectangle {
                background: #12121a;
                border-radius: 12px;
                padding: 20px;
                min-width: 300px;
                
                VerticalLayout {
                    spacing: 12px;
                    
                    Text {
                        text: "历史记录";
                        font-size: 14px;
                        font-weight: 600;
                        color: #e5e7eb;
                    }
                    
                    if root.history.length > 0: ListView {
                        for item in root.history: Rectangle {
                            background: #1a1a24;
                            border-radius: 8px;
                            padding: 12px;
                            
                            VerticalLayout {
                                spacing: 4px;
                                
                                Text {
                                    text: item.id;
                                    font-size: 12px;
                                    color: #e5e7eb;
                                    wrap: word-wrap;
                                }
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    
                                    Text {
                                        text: item.geo_level;
                                        font-size: 10px;
                                        color: #6b7280;
                                    }
                                    
                                    Text {
                                        text: item.time;
                                        font-size: 10px;
                                        color: #6b7280;
                                    }
                                }
                            }
                        }
                    }
                    
                    if root.history.length == 0: Text {
                        text: "暂无历史记录";
                        font-size: 12px;
                        color: #4b5563;
                    }
                }
            }
        }
    }
}
