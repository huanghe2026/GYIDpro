---
import { ui, SITE, type Lang } from '../../i18n/ui';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const a = t.about;
---

<div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  <Eyebrow>{a.eyebrow}</Eyebrow>
  <h1 class="mt-4 max-w-3xl text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">
    {a.title}
  </h1>
  <p class="mt-5 max-w-3xl text-base leading-relaxed text-white/70">{a.lead}</p>
</div>

<div class="mx-auto max-w-6xl space-y-5 px-4 pb-10">
  {
    a.sections.map((s) => (
      <article class="cyber-border p-6 sm:p-8">
        <h2 class="text-xl font-black tracking-tight text-white">{s.title}</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/70">{s.body}</p>
        {s.points && (
          <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
            {s.points.map((pt) => (
              <li class="flex gap-2.5 text-sm leading-relaxed text-white/65">
                <span class="mt-[3px] shrink-0 text-cyber-blue">▸</span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</div>

<section class="mx-auto max-w-6xl px-4 py-12">
  <SectionHeading title={a.statusTitle} />
  <div class="cyber-border mt-8 overflow-x-auto">
    <table class="w-full text-sm">
      <tbody>
        {
          a.statusRows.map((r) => (
            <tr class="border-b border-white/[0.05] last:border-0">
              <td class="whitespace-nowrap px-5 py-3.5 font-mono text-cyber-cyan">{r[0]}</td>
              <td class="px-5 py-3.5 text-white/65">{r[1]}</td>
              <td class="whitespace-nowrap px-5 py-3.5 text-right">
                <span class:list={['badge', r[2] === '未开始' || r[2] === 'Not started' ? 'badge-mute' : 'badge-ok']}>
                  {r[2]}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mt-10 flex flex-wrap gap-4">
    <a
      href={SITE.github}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-xl border border-cyber-blue/50 bg-cyber-blue/15 px-5 py-3 text-sm font-bold text-cyber-blue transition hover:bg-cyber-blue/25"
      >GitHub · huanghe2026/GYIDpro</a
    >
  </div>
</section>
