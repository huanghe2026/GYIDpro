---
import { ui, SITE, type Lang } from '../../i18n/ui';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const p = t.protocol;
---

<div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  <Eyebrow>{p.eyebrow}</Eyebrow>
  <h1 class="mt-4 max-w-3xl text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">
    {p.title}
  </h1>
  <p class="mt-5 max-w-3xl text-base leading-relaxed text-white/70">{p.lead}</p>
  <p class="mt-4 font-mono text-xs text-white/40">
    baseline: <code class="text-cyber-cyan">{SITE.draft}</code> · IETF RATS
  </p>
</div>

<div class="mx-auto max-w-6xl space-y-6 px-4 pb-8">
  {
    p.sections.map((s, i) => (
      <article class="cyber-border p-6 sm:p-8">
        <div class="flex items-baseline gap-3">
          <span class="font-cyber text-lg font-black text-cyber-blue/40">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h2 class="text-xl font-black tracking-tight text-white">{s.title}</h2>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-white/70">{s.body}</p>
        <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
          {s.points.map((pt) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-white/65">
              <span class="mt-[3px] shrink-0 text-cyber-blue">▸</span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>

<section class="mx-auto max-w-6xl px-4 py-12">
  <SectionHeading title={p.tableTitle} />
  <div class="cyber-border mt-8 overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-white/[0.08]">
          {
            p.tableHead.map((c) => (
              <th class="px-5 py-3 text-left font-mono text-[11px] uppercase tracking-widest text-cyber-blue">
                {c}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          p.tableRows.map((r) => (
            <tr class="border-b border-white/[0.05] last:border-0">
              <td class="whitespace-nowrap px-5 py-3.5 font-mono text-cyber-cyan">{r[0]}</td>
              <td class="px-5 py-3.5 font-bold text-white">{r[1]}</td>
              <td class="px-5 py-3.5 text-white/60">{r[2]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<div class="mx-auto max-w-6xl px-4 pb-16">
  <blockquote class="cyber-border border-l-2 border-l-cyber-yellow/60 p-5 text-sm text-white/60">
    {p.note}
  </blockquote>
</div>
