---
import { ui, path, SITE, type Lang } from '../../i18n/ui';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const d = t.docs;
---

<div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  <Eyebrow>{t.nav.docs}</Eyebrow>
  <h1 class="mt-4 max-w-3xl text-3xl font-black leading-tight tracking-tight text-white sm:text-4xl">
    {d.indexTitle}
  </h1>
  <p class="mt-5 max-w-3xl text-base leading-relaxed text-white/70">{d.indexLead}</p>
</div>

<div class="mx-auto grid max-w-6xl gap-6 px-4 pb-16 md:grid-cols-3">
  {
    d.cards.map((c) => (
      <a href={path(lang, c.slug)} class="cyber-border group p-6 transition hover:border-cyber-blue/35">
        <h2 class="text-lg font-black text-white transition group-hover:text-cyber-blue">{c.title}</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/60">{c.desc}</p>
        <span class="mt-5 inline-block font-mono text-xs text-cyber-blue">→</span>
      </a>
    ))
  }
</div>

<div class="mx-auto max-w-6xl px-4 pb-16">
  <div class="cyber-border p-6">
    <h2 class="text-sm font-bold uppercase tracking-widest text-cyber-blue">repository</h2>
    <p class="mt-3 text-sm leading-relaxed text-white/60">
      {t.footer.draftNote} <code class="text-cyber-cyan">{SITE.draft}</code>
    </p>
    <a
      href={SITE.github}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-block font-mono text-sm text-cyber-blue underline">github.com/huanghe2026/GYIDpro</a
    >
  </div>
</div>
