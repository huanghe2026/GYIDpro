---
interface Props {
  title: string;
  lead?: string;
  align?: 'left' | 'center';
}

const { title, lead, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' ? 'mx-auto text-center' : '']}>
  <h2 class="text-2xl font-black tracking-tight text-white sm:text-3xl">{title}</h2>
  {lead && <p class="mt-3 text-base leading-relaxed text-white/60">{lead}</p>}
</div>
