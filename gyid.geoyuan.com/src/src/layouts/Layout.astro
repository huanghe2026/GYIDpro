---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { swapLocale } from '../i18n/utils';

interface Props {
  locale: 'en' | 'zh';
  path: string;
  title: string;
  description: string;
}
const { locale, path, title, description } = Astro.props;
const site = 'https://www.geoyuan.com';
const canonical = site + path;
const altPath = swapLocale(path, locale === 'en' ? 'zh' : 'en');
const altHref = site + altPath;
const htmlLang = locale === 'en' ? 'en' : 'zh';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GyID',
  alternateName: 'Geoyuan ID',
  applicationCategory: 'IdentityVerificationApplication',
  operatingSystem: 'Windows, macOS, Linux, Android, iOS, Web',
  description,
  url: canonical,
};
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00ffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'en' ? 'zh' : 'en'} href={altHref} />
    <link rel="alternate" hreflang={locale} href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:site_name" content="Geoyuan" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.svg" />

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- Language redirect (English pages only): send zh browsers to /zh unless chosen manually -->
    {
      locale === 'en' && (
        <script is:inline set:html={`
          (function() {
            if (sessionStorage.getItem('lang-chosen')) return;
            var p = window.location.pathname;
            var isZh = p.startsWith('/zh');
            var browserLang = navigator.language || navigator.userLanguage || '';
            var isChinese = browserLang.toLowerCase().startsWith('zh');
            if (isChinese && !isZh) {
              sessionStorage.setItem('lang-chosen', 'zh');
              window.location.href = '/zh' + (p === '/' ? '' : p);
              return;
            }
            if (!isChinese && !isZh) {
              fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(3000) })
                .then(function(r){ return r.json(); })
                .then(function(data){ if (data.country_code === 'CN') { sessionStorage.setItem('lang-chosen','zh'); window.location.href = '/zh' + (p === '/' ? '' : p); } })
                .catch(function(){});
            }
          })();
        `} />
      )
    }

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;800;900&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-cyber-bg cyber-grid-bg">
    <!-- Scanlines overlay -->
    <div class="fixed inset-0 pointer-events-none z-50 scanlines"></div>

    <Header locale={locale} path={path} />

    <main class="flex-1 pt-16">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
