---
import { footer } from '../i18n/content';

interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;
const f = footer[locale];
---

<footer class="border-t border-cyber-border mt-20" style="background: rgba(10,10,15,0.95);">
  <div class="h-px w-full" style="background: linear-gradient(90deg, transparent, #00ffff, #ff00ff, #00ffff, transparent);"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-6 h-6 border border-cyber-cyan rotate-45 flex items-center justify-center">
            <span class="font-orbitron font-black text-cyber-cyan text-[10px] -rotate-45">G</span>
          </div>
          <span class="font-orbitron font-black text-lg text-cyber-text">{locale === 'en' ? 'GEOYUAN' : '地理元'}</span>
        </div>
        <p class="text-cyber-text-dim text-sm leading-relaxed mb-4">{f.tagline}</p>
        <p class="font-mono text-xs text-cyber-text-dim">{f.builtWith}</p>
      </div>

      <!-- Product -->
      <div>
        <h4 class="font-orbitron text-xs font-bold uppercase tracking-widest text-cyber-cyan mb-4">{f.productTitle}</h4>
        <ul class="space-y-2">
          {
            f.product.map((it) => (
              <li>
                <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} class="text-sm text-cyber-text-dim hover:text-cyber-cyan transition-colors">
                  {it.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="font-orbitron text-xs font-bold uppercase tracking-widest text-cyber-cyan mb-4">{f.resourceTitle}</h4>
        <ul class="space-y-2">
          {
            f.resource.map((it) => (
              <li>
                <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} class="text-sm text-cyber-text-dim hover:text-cyber-cyan transition-colors">
                  {it.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h4 class="font-orbitron text-xs font-bold uppercase tracking-widest text-cyber-cyan mb-4">{f.communityTitle}</h4>
        <ul class="space-y-2">
          <li>
            <span class="text-sm text-cyber-text-dim flex items-center gap-1"><span class="text-cyber-cyan">✉</span> {f.email}</span>
          </li>
          <li>
            <span class="text-sm text-cyber-text-dim flex items-center gap-1"><span class="text-cyber-yellow">💬</span> {f.wechat}</span>
          </li>
          <li><span class="text-sm text-cyber-text-dim flex items-center gap-1"><span class="text-cyber-cyan">⬡</span> {f.protocol}</span></li>
          <li><span class="font-mono text-xs text-cyber-border">{f.chains}</span></li>
        </ul>
      </div>
    </div>

    <div class="cyber-divider"></div>
    <div class="flex flex-col sm:flex-row justify-between items-center gap-3 pt-2">
      <p class="font-mono text-xs text-cyber-text-dim">{f.copyright}</p>
      <div class="flex items-center gap-4">
        <span class="cyber-badge text-[10px] py-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-cyber-green animate-pulse"></span>
          {f.online}
        </span>
        <span class="font-mono text-xs text-cyber-border">{f.version}</span>
      </div>
    </div>
  </div>
</footer>
