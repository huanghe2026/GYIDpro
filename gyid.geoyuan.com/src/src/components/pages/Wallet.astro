---
import { pages } from '../../i18n/content';
interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;
const t = pages[locale].wallet;
---

<!-- HERO -->
<section class="py-24 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto text-center fade-in-up">
    <div class="cyber-badge mb-6 mx-auto inline-flex">{t.hero.badge}</div>
    <h1 class="font-orbitron font-black text-4xl md:text-5xl text-cyber-text">{t.hero.title}</h1>
    <p class="neon-cyan font-orbitron text-lg md:text-xl mt-3">{t.hero.subtitle}</p>
    <p class="section-subtitle mx-auto text-center mt-6">{t.hero.desc}</p>
  </div>
</section>

<!-- FEATURES -->
<section class="py-20 px-4 sm:px-6" style="background: rgba(0,0,0,0.25);">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      t.features.map((f) => (
        <div class="cyber-card cyber-corner p-6">
          <div class="text-3xl mb-3">{f.icon}</div>
          <h3 class="font-orbitron font-bold text-base text-cyber-text mb-2 group-hover:text-cyber-cyan">{f.title}</h3>
          <p class="text-cyber-text-dim text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))
    }
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="py-20 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14">
      <div class="cyber-badge mb-4 mx-auto inline-flex">{t.how.badge}</div>
      <h2 class="section-title font-orbitron">{t.how.title}</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        t.how.steps.map((s) => (
          <div class="cyber-card p-6 text-center">
            <div class="font-orbitron font-black text-4xl neon-magenta mb-3">{s.n}</div>
            <h3 class="font-orbitron font-bold text-lg text-cyber-text mb-2">{s.title}</h3>
            <p class="text-cyber-text-dim text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- P2P -->
<section class="py-20 px-4 sm:px-6" style="background: rgba(0,0,0,0.25);">
  <div class="max-w-5xl mx-auto">
    <div class="cyber-card p-8 md:p-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-3xl">{t.p2p.icon}</span>
        <div>
          <div class="cyber-badge inline-flex">{t.p2p.badge}</div>
          <h2 class="section-title font-orbitron text-2xl mt-2">{t.p2p.title}</h2>
        </div>
      </div>
      <p class="text-cyber-text-dim leading-relaxed mb-6">{t.p2p.desc}</p>
      <ul class="space-y-2">
        {t.p2p.points.map((p) => <li class="flex items-center gap-2 text-cyber-text-dim"><span class="text-cyber-cyan">▶</span> {p}</li>)}
      </ul>
    </div>
  </div>
</section>

<!-- ARCHITECTURE -->
<section class="py-20 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto text-center">
    <div class="cyber-badge mb-6 mx-auto inline-flex">{t.arch.badge}</div>
    <h2 class="section-title font-orbitron mb-8">{t.arch.title}</h2>
    <div class="cyber-card p-6 text-left">
      <pre class="code-block !border-l-0 !bg-transparent !border-0 text-cyber-text-dim text-sm overflow-x-auto">{t.arch.ascii}</pre>
    </div>
    <p class="font-mono text-xs text-cyber-cyan mt-4">{t.arch.footer}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <a href={t.arch.primaryBtn.href} class="btn-cyber">{t.arch.primaryBtn.label}</a>
      <a href={t.arch.secondaryBtn.href} class="btn-cyber-outline">{t.arch.secondaryBtn.label}</a>
    </div>
  </div>
</section>
