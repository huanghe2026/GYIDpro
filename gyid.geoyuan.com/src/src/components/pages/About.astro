---
import { pages } from '../../i18n/content';
interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;
const t = pages[locale].about;
---

<!-- HERO -->
<section class="py-24 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto text-center fade-in-up">
    <div class="cyber-badge mb-6 mx-auto inline-flex">{t.hero.badge}</div>
    <h1 class="font-orbitron font-black text-4xl md:text-5xl text-cyber-text">{t.hero.title}</h1>
    <p class="neon-cyan font-orbitron text-lg md:text-xl mt-3">{t.hero.subtitle}</p>
  </div>
</section>

<!-- VISION + MISSION -->
<section class="py-16 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="cyber-card cyber-corner p-8">
      <div class="font-orbitron font-black text-5xl neon-cyan mb-4">{t.vision.n}</div>
      <h3 class="font-orbitron font-bold text-xl text-cyber-text mb-3">{t.vision.title}</h3>
      <p class="text-cyber-text-dim leading-relaxed">{t.vision.desc}</p>
    </div>
    <div class="cyber-card cyber-corner p-8">
      <div class="font-orbitron font-black text-5xl neon-magenta mb-4">{t.mission.n}</div>
      <h3 class="font-orbitron font-bold text-xl text-cyber-text mb-3">{t.mission.title}</h3>
      <p class="text-cyber-text-dim leading-relaxed">{t.mission.desc}</p>
    </div>
  </div>
</section>

<!-- TECH STACK -->
<section class="py-16 px-4 sm:px-6" style="background: rgba(0,0,0,0.25);">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <div class="cyber-badge mb-4 mx-auto inline-flex">{t.tech.badge}</div>
      <h2 class="section-title font-orbitron">{t.tech.title}</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        t.tech.items.map((it) => (
          <div class="cyber-card p-5 flex items-center gap-4">
            <span class="font-orbitron font-black text-2xl neon-cyan">{it.n}</span>
            <span class="font-orbitron text-cyber-text">{it.title}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="py-16 px-4 sm:px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <div class="cyber-badge mb-4 mx-auto inline-flex">{t.contact.badge}</div>
      <h2 class="section-title font-orbitron">{t.contact.title}</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {
        t.contact.items.map((it) => (
          <div class="cyber-card cyber-corner p-6 text-center">
            <div class="text-3xl mb-3">{it.icon}</div>
            <div class="font-orbitron font-bold text-cyber-text text-sm mb-1">{it.title}</div>
            {it.href ? (
              <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} class="font-mono text-xs text-cyber-cyan hover:underline break-all">{it.value}</a>
            ) : (
              <span class="font-mono text-xs text-cyber-text-dim break-all">{it.value}</span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
