---
import { pages } from '../../i18n/content';
interface Props {
  locale: 'en' | 'zh';
}
const { locale } = Astro.props;
const t = pages[locale].home;
const isZh = locale === 'zh';
---

<!-- HERO -->
<section class="relative overflow-hidden py-24 px-4 sm:px-6">
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 50% 0%, rgba(0,240,255,0.10), transparent 55%);"></div>
  <div class="relative max-w-4xl mx-auto text-center fade-in-up">
    <div class="cyber-badge mb-6 mx-auto inline-flex">{t.hero.badge}</div>
    <h1 class="font-orbitron font-black text-4xl md:text-6xl leading-tight text-cyber-text">
      {t.hero.titleTop}<br />
      <span class="neon-cyan">{t.hero.titleBottom}</span>
    </h1>
    <p class="section-subtitle mx-auto text-center mt-6 text-base md:text-lg">{t.hero.subtitle}</p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
      <a href={t.hero.primaryBtn.href} class="btn-cyber">{t.hero.primaryBtn.label}</a>
      <a href={t.hero.walletPromo.href} class="cyber-card cyber-corner inline-flex items-center gap-3 px-5 py-3 hover:border-cyber-cyan transition-colors">
        <span class="text-2xl">{t.hero.walletPromo.icon}</span>
        <span class="text-left">
          <span class="block text-sm text-cyber-text font-orbitron">{t.hero.walletPromo.title}</span>
          <span class="block text-xs text-cyber-cyan">{t.hero.walletPromo.cta}</span>
        </span>
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4 max-w-xl mx-auto mt-14">
      {
        t.stats.map((s) => (
          <div class="stat-box">
            <div class="font-orbitron font-black text-2xl neon-cyan">{s.value}</div>
            <div class="font-mono text-xs text-cyber-text-dim mt-1 uppercase tracking-wider">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="py-24 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <div class="cyber-badge mb-4 mx-auto inline-flex">{t.features.badge}</div>
      <h2 class="section-title font-orbitron">{t.features.title}</h2>
      <p class="section-subtitle mx-auto text-center mt-4">{t.features.subtitle}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        t.features.items.map((it, i) => (
          <div class="cyber-card cyber-corner p-6 group" style={`animation-delay:${i * 0.05}s`}>
            <div class="text-3xl mb-4 animate-float" style={`animation-delay:${i * 0.2}s`}>{it.icon}</div>
            <h3 class="font-orbitron font-bold text-base text-cyber-text mb-2 group-hover:text-cyber-cyan transition-colors">{it.title}</h3>
            <p class="text-cyber-text-dim text-sm leading-relaxed">{it.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="py-24 px-4 sm:px-6" style="background: rgba(0,0,0,0.25);">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <div class="cyber-badge mb-4 mx-auto inline-flex">{t.how.badge}</div>
      <h2 class="section-title font-orbitron">{t.how.title}</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        t.how.steps.map((s) => (
          <div class="cyber-card p-6 text-center">
            <div class="font-orbitron font-black text-4xl neon-magenta mb-3">{s.n}</div>
            <h3 class="font-orbitron font-bold text-lg text-cyber-text mb-2">{s.title}</h3>
            <p class="text-cyber-text-dim text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- LIVE APP -->
<section class="py-24 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <div class="cyber-card cyber-corner p-8 md:p-10 flex flex-col md:flex-row items-center gap-8" style="border-color: rgba(255,43,214,0.3);">
      <div class="flex-1">
        <div class="cyber-badge mb-4 inline-flex" style="border-color: rgba(255,43,214,0.5); color: var(--color-cyber-magenta);">{t.liveApp.badge}</div>
        <h2 class="font-orbitron font-black text-2xl md:text-3xl text-cyber-text mb-3">{t.liveApp.title}</h2>
        <p class="text-cyber-text-dim text-base max-w-lg leading-relaxed">{t.liveApp.desc}</p>
        <div class="flex flex-wrap gap-2 mt-4">
          {t.liveApp.tags.map((tag) => <span class="font-mono text-xs text-cyber-border border border-cyber-border px-2 py-0.5">{tag}</span>)}
        </div>
      </div>
      <div class="flex flex-col gap-3 w-full md:w-auto">
        <a href={t.liveApp.primaryBtn.href} target="_blank" rel="noopener" class="btn-cyber-magenta whitespace-nowrap">{t.liveApp.primaryBtn.label}</a>
        <a href={t.liveApp.secondaryBtn.href} class="btn-cyber-outline text-center">{t.liveApp.secondaryBtn.label}</a>
      </div>
    </div>
  </div>
</section>

<!-- GET STARTED -->
<section class="py-24 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto text-center">
    <div class="cyber-badge mb-6 mx-auto inline-flex">{t.getStarted.badge}</div>
    <h2 class="font-orbitron font-black text-3xl md:text-4xl text-cyber-text mb-4">{t.getStarted.title}</h2>
    <p class="text-cyber-text-dim text-lg mb-10 max-w-xl mx-auto">{t.getStarted.subtitle}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={t.getStarted.primaryBtn.href} class="btn-cyber">{t.getStarted.primaryBtn.label}</a>
      <a href={t.getStarted.secondaryBtn.href} class="btn-cyber-outline">{t.getStarted.secondaryBtn.label}</a>
    </div>
  </div>
</section>
