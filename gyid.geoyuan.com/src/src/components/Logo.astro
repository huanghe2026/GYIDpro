---
interface Props {
  locale: 'en' | 'zh';
  className?: string;
}
const { locale, className = '' } = Astro.props;
const brand = locale === 'en' ? 'GEOYUAN' : '地理元';
const tagline = locale === 'en' ? 'geo · identity · web3' : 'Decentralized ID';
const home = locale === 'en' ? '/' : '/zh';
---

<a href={home} class={`flex items-center gap-3 group ${className}`}>
  <div class="relative w-8 h-8 flex items-center justify-center shrink-0">
    <div class="absolute inset-0 border border-cyber-cyan opacity-60 rotate-45 transition-transform group-hover:rotate-[60deg] duration-500"></div>
    <div class="absolute inset-1 border border-cyber-magenta opacity-40 rotate-12 transition-transform group-hover:rotate-[30deg] duration-500"></div>
    <span class="relative font-orbitron font-black text-cyber-cyan text-xs">G</span>
  </div>
  <div class="flex flex-col leading-none">
    <span class="font-orbitron font-black text-base text-cyber-text tracking-wider group-hover:text-cyber-cyan transition-colors">{brand}</span>
    <span class="font-mono text-[9px] text-cyber-text-dim tracking-widest uppercase">{tagline}</span>
  </div>
</a>
