{
  "name": "gyid-webbutton",
  "version": "1.0.0",
  "buildDate": "2026-04-06",
  "description": "GYID WebButton - 可嵌入网页的 GYID 生成器",
  "files": [
    "index.html",
    "embed.html",
    "README.md",
    "css/gyid-webbutton.css",
    "js/gyid-webbutton.js",
    "js/qrcode.min.js"
  ],
  "features": {
    "fingerprint": {
      "enabled": true,
      "weight": 0.40,
      "items": ["userAgent", "screen", "timezone", "canvas", "webgl"]
    },
    "geo": {
      "enabled": true,
      "weight": 0.35,
      "levels": ["L1", "L2", "L3"],
      "default": "L1"
    },
    "avatar": {
      "enabled": true,
      "weight": 0.15,
      "maxSize": "5MB",
      "formats": ["jpg", "png", "webp"]
    },
    "chain": {
      "enabled": true,
      "options": ["local", "polygon", "aptos"],
      "default": "local"
    },
    "qrExport": {
      "enabled": true,
      "actions": ["copy", "json-export"]
    }
  },
  "requirements": {
    "browser": "Chrome 60+, Firefox 55+, Safari 11+, Edge 79+",
    "features": ["crypto.subtle", "navigator.geolocation", "Canvas API"]
  },
  "cdn": {
    "production": "https://geoyuan.com/tools/webbutton/z/",
    "js": "https://geoyuan.com/tools/webbutton/z/js/gyid-webbutton.js",
    "css": "https://geoyuan.com/tools/webobutton/z/css/gyid-webbutton.css"
  }
}
